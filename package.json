    "@testing-library/react": "latest",
    "@types/node": "24.10.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "6.0.2",
    "vitest": "latest"
